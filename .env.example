# Copia este archivo a .env
# Pega el token que te da @BotFather en Telegram
TELEGRAM_TOKEN=

# Cadena de conexión de tu base en Neon (crea el proyecto en https://console.neon.tech)
# Ej: postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# URL pública de la API para el frontend (en local: http://localhost:8000)
PUBLIC_API_URL=
